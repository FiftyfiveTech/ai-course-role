# Names only — never real values. Real keys live in ~/.config/, outside the repo.
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional — tracing is opt-in. Set to http://localhost:4318 after
# `make otel-up` to export spans to Tempo, viewable at http://localhost:3000.
# Unset (default): zero overhead, no-op tracer, no Docker required.
OTEL_EXPORTER_OTLP_ENDPOINT=
